{
  "name": "slg-battle-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic engine-agnostic battle core. Zero runtime dependencies.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test build/tests/*.test.js",
    "golden": "npm run build && node build/tools/make-golden.js",
    "stress": "npm run build && node build/tools/stress.js",
    "export-config": "npm run build && node build/tools/export-config.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
