    { "id": "xiangxing", "名称": "相性", "分类": "人事", "简述": "1–149 环形数值，影响登庸与忠诚，但不是唯一参数。未侦察敌将只给模糊区间。", "数值来源": ["本作尚未实装，属设计规格中的待补字段"], "关联词条": ["dengyong", "zhongcheng", "longluo"], "证据级别": "本作设定", "source_id": "design:6.8", "confidence": "中" },
