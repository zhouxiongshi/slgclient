    { "id": "dengyong", "名称": "登庸", "分类": "人事", "简述": "探索 → 发现 → 笼络 → 登庸 → 首招确认。三顾之礼：同一人被拒一次，再次登门成功率 +12%。", "数值来源": ["handlers.js general.explore", "state.tavern.favor"], "关联词条": ["zaiye", "xiangxing", "longluo"], "证据级别": "本作设定（借鉴三国志11）", "source_id": "handler:general.explore", "confidence": "高" },
    { "id": "zaiye", "名称": "在野", "分类": "人事", "简述": "尚未出仕的武将。除主动探索登庸外，还会按名声每旬自动来投（出仕）。", "数值来源": ["state.tavern.people", "strategy.defectTick"], "关联词条": ["chushi", "dengyong", "mingsheng"], "证据级别": "本作设定", "source_id": "strategy:defectTick", "confidence": "高" },
    { "id": "chushi", "名称": "出仕", "分类": "人事", "简述": "在野贤才主动来投。名声 = 城池数×8 + 帐下武将×2 + 君主魅力/100，每旬概率 3%~45%，上限 45%。", "数值来源": ["strategy.defectTick"], "关联词条": ["mingsheng", "zaiye"], "证据级别": "本作设定（借鉴三国志11/14 名声）", "source_id": "strategy:defectTick", "confidence": "高" },
    { "id": "mingsheng", "名称": "名声", "分类": "势力", "简述": "影响在野武将来投概率。构成见「出仕」，界面逐项可查。", "数值来源": ["strategy.defectTick:fame"], "关联词条": ["chushi", "zaiye"], "证据级别": "本作设定", "source_id": "strategy:defectTick", "confidence": "高" },
    { "id": "zhaoxiang", "名称": "招降", "分类": "人事", "简述": "消耗 300 金。成功率 = 45% + 关押旬数×5% + 君主政治×0.2%，上限 95%。仅在成功时扣费，失败不收费。", "数值来源": ["domain/captive-rules.js", "strategy.recruitCaptive"], "关联词条": ["fulu", "zhongcheng", "chenggonglv"], "证据级别": "本作设定", "source_id": "rule:captive-rules", "confidence": "高" },
    { "id": "fulu", "名称": "俘虏", "分类": "人事", "简述": "押着的敌将，每旬忠诚 -2；低于 30 且有 30% 越狱风险。招降／归还／释放／处决中当前仅实装招降与越狱。", "数值来源": ["state.captives", "strategy.captivesTick"], "关联词条": ["zhaoxiang", "zhongcheng"], "证据级别": "本作设定", "source_id": "strategy:captivesTick", "confidence": "高" },
    { "id": "chenggonglv", "名称": "成功率构成", "分类": "规则", "简述": "任何概率都必须拆成「基础 + 各加成项 + 上限截断 = 最终」，不允许只给一个百分比。确定性内核下优先只读预演。", "数值来源": ["domain/captive-rules.js:captiveRateParts"], "关联词条": ["zhaoxiang", "yansuan"], "证据级别": "设计规格 2.3 / 6.2", "source_id": "design:2.3", "confidence": "高" },
    { "id": "zhanfa", "名称": "战法", "分类": "战斗", "简述": "六字段：类型／有效距离／目标类型／兵种限制／发动率／属性依赖。描述文本由同一份配置生成，与内核计算同源。", "数值来源": ["conf/skills.json", "conf/skills-range.json", "kernel/engine.js"], "关联词条": ["youxiaojuli", "mubiaoleixing", "fadonglv"], "证据级别": "本作配置", "source_id": "conf:skills", "confidence": "高" },
    { "id": "youxiaojuli", "名称": "有效距离", "分类": "战斗", "简述": "战场三槽：前锋0／中军1／大营2；跨阵营距离 = 双方槽位之和 + 1（1~5）。距离不够时单体战法打空、群体命中人数减少、普攻打不出。追击战法与治疗／增益无距离限制（9）。", "数值来源": ["conf/skills-range.json:derive", "kernel/engine.js:slotDist"], "关联词条": ["zhanwei", "zhanfa", "pugongjuli"], "证据级别": "同行业描述约定 + 本作配置", "source_id": "conf:skills-range", "confidence": "高" },
    { "id": "zhanwei", "名称": "战位", "分类": "战斗", "简述": "前锋／中军／大营三槽。站位决定能否打到目标，是编队决策的一部分，不是装饰。", "数值来源": ["kernel/engine.js:pos"], "关联词条": ["youxiaojuli", "biandui"], "证据级别": "本作设定", "source_id": "kernel:engine", "confidence": "高" },
    { "id": "pugongjuli", "名称": "普攻距离", "分类": "战斗", "简述": "武将 attack_distance 优先，缺省按兵种：盾3／弓4／骑3。距离不足时该武将本回合普攻无法命中。", "数值来源": ["conf/skills-range.json:attackDistance", "skills.js:attackDistanceOf"], "关联词条": ["youxiaojuli", "bingshi"], "证据级别": "本作配置", "source_id": "conf:skills-range", "confidence": "高" },
    { "id": "mubiaoleixing", "分类": "战斗", "名称": "目标类型", "简述": "单体(t6)／群体(t7,t8,t9)／我方。目标人数与有效距离一起写进战法描述，玩家点之前就能看到。", "数值来源": ["conf/skills.json:ui.target"], "关联词条": ["zhanfa", "youxiaojuli"], "证据级别": "本作配置", "source_id": "conf:skills", "confidence": "高" },
    { "id": "fadonglv", "名称": "发动率", "分类": "战斗", "简述": "战法按等级给定的发动概率，Lv1~Lv10 曲线开局公开。确定性内核下由种子决定，不是隐藏随机。", "数值来源": ["conf/skills.json:ui.levels[].probability"], "关联词条": ["zhanfa", "yansuan"], "证据级别": "本作配置", "source_id": "conf:skills", "confidence": "高" },
    { "id": "bingshi", "名称": "兵种克制", "分类": "战斗", "简述": "盾／弓／骑相互克制。编队与战前推演中必须能预演，而非结算后才知道。", "数值来源": ["city-econ.armsCounter", "kernel/config.js:counter_tiers"], "关联词条": ["shixing", "biandui"], "证据级别": "本作设定", "source_id": "econ:armsCounter", "confidence": "中" },
    { "id": "shixing", "名称": "适性", "分类": "武将", "简述": "武将对各兵种的适配度，影响部队战力与战法发挥。", "数值来源": ["city-econ.armsApt", "state.generals"], "关联词条": ["bingshi", "biandui"], "证据级别": "本作设定", "source_id": "econ:armsApt", "confidence": "中" },
    { "id": "biandui", "名称": "编队", "分类": "部队", "简述": "主将／副将／兵种／阵型／适性／连携的组合。同一武将不能重复上阵；队伍行军中不可整编。", "数值来源": ["handlers.js army.formup", "state.armys"], "关联词条": ["chuzheng", "shixing", "zhanwei"], "证据级别": "本作设定", "source_id": "handler:army.formup", "confidence": "高" },
    { "id": "chuzheng", "名称": "出征", "分类": "部队", "简述": "选目标城 → 选出发城（连通且有存粮）→ 编队 → 补给确认 → 行军 → 到达日结算。出发城可以是任意己方城。", "数值来源": ["strategy.strategyAttack", "conf/campaign/strategy/detail.json"], "关联词条": ["xingjun", "liangdao", "biandui"], "证据级别": "本作设定", "source_id": "strategy:strategyAttack", "confidence": "高" },
    { "id": "xingjun", "名称": "行军", "分类": "地图", "简述": "时长 = ceil(里程 ÷ (MARCH_KM_BASE × 速度/100))，夹在 1~40 日。玩家与诸侯共用同一公式；地图军标按剩余里程插值移动。", "数值来源": ["strategy.marchDaysBy", "strategy.marchKmBetween", "state.strategy.marches"], "关联词条": ["chuzheng", "liangdao", "ETA"], "证据级别": "本作设定", "source_id": "strategy:marchDaysBy", "confidence": "高" },
    { "id": "ETA", "名称": "预计抵达", "分类": "地图", "简述": "arriveDay = departDay + 行军日数。行军队列常驻显示剩余日，可撤回。", "数值来源": ["state.strategy.marches[].arriveDay"], "关联词条": ["xingjun", "duilie"], "证据级别": "本作设定", "source_id": "strategy:marches", "confidence": "高" },
    { "id": "liangdao", "名称": "粮道／兵站", "分类": "地图", "简述": "三国志14 官方口径：涂色连线即补给线，被截 → 断粮 → 混乱/足止。与「补给范围」「营帐/要塞」是三套不同规则，本作只取粮道。粮优先从出发城城库扣，城库不足吃全局池并 +25% 损耗。", "数值来源": ["strategy.strategyAttack:992", "design:附录C"], "关联词条": ["duanliang", "yunshu", "chuzheng"], "证据级别": "官方情报（三国志14）+ 本作设定", "source_id": "design:terms", "confidence": "中" },
    { "id": "duanliang", "名称": "断粮", "分类": "地图", "简述": "粮道被截或存粮耗尽的后果。出征确认页应前置显示沿途己方府、每日耗粮与可支撑回合数。", "数值来源": ["strategy.supplyStops（当前仅记录，尚无消费方）"], "关联词条": ["liangdao", "shiqi"], "证据级别": "设计规格 6.5（本作待实装）", "source_id": "design:6.5", "confidence": "中" },
    { "id": "yunshu", "名称": "运输", "分类": "内政", "简述": "从己方城向己方城运粮，生成可见运输队，抵达即入城库。粮不足或目标非己方城会被拒绝。", "数值来源": ["strategy.strategyTransport", "state.strategy.marches(kind=transport)"], "关联词条": ["liangdao", "chengku"], "证据级别": "本作设定", "source_id": "strategy:strategyTransport", "confidence": "高" },
    { "id": "chengku", "名称": "城库存粮", "分类": "经济", "简述": "逐城独立的粮仓。行军优先扣出发城城库，不足才动全局府库。", "数值来源": ["state.cityEcon[id].store"], "关联词条": ["fuku", "yunshu", "liangdao"], "证据级别": "本作设定", "source_id": "econ:cityEcon", "confidence": "高" },
    { "id": "fuku", "名称": "府库", "分类": "经济", "简述": "全局资源池 gold/grain/wood/iron/stone/decree。与逐城城库是两本账，界面要能对账。", "数值来源": ["state.roleRes"], "关联词条": ["chengku", "fenglu", "chanliang"], "证据级别": "本作设定", "source_id": "econ:roleRes", "confidence": "高" },
    { "id": "chanliang", "名称": "产量", "分类": "经济", "简述": "逐城粮产／金产由农业、商业、开发度、官员加成、灾害修正共同决定。界面应显示「基础 + 各加成项 = 最终」。", "数值来源": ["city-econ.cityYield", "economy.applyDays"], "关联词条": ["kaifadu", "zaihai", "weiren"], "证据级别": "本作设定", "source_id": "econ:cityYield", "confidence": "高" },
    { "id": "kaifadu", "名称": "开发度", "分类": "内政", "简述": "农田／市集／兵营／城防四条开发线。委任官员按属性逐旬推进，开发度再反馈到产量。", "数值来源": ["city-econ.cityDevTick", "state.cityEcon[id].devAgri/devTrade/devArms/devDef"], "关联词条": ["weiren", "chanliang", "neizheng"], "证据级别": "本作设定（借鉴三国志14）", "source_id": "econ:cityDevTick", "confidence": "高" },
    { "id": "weiren", "名称": "委任", "分类": "内政", "简述": "把武将放到岗位上，产生逐旬任务对象与归因报告。与「一键结算」的区别是有执行武将、起止回合、每回合增量与反馈。", "数值来源": ["state.interior.posts", "city-econ.cityDevTick"], "关联词条": ["renwuzhuang", "kaifadu", "neizheng"], "证据级别": "系列机制 + 本作设定", "source_id": "econ:cityDevTick", "confidence": "中" },
    { "id": "renwuzhuang", "名称": "任务状", "分类": "内政", "简述": "内政任务对象：{执行武将, 目标城/区域, 开始回合, 预计完成, 每回合增量, 消耗, 状态}。当前版本仍是一次性按钮，属待补深度。", "数值来源": ["design:6.7（本作待实装）"], "关联词条": ["weiren", "neizheng"], "证据级别": "设计规格 6.7", "source_id": "design:6.7", "confidence": "中" },
    { "id": "neizheng", "名称": "内政", "分类": "内政", "简述": "五项内政：农田／市集／兵营／城防／治安，各自独立冷却，花全局金、涨逐城开发度。", "数值来源": ["strategy.strategyInvest:KINDS", "state.strategy.investDays"], "关联词条": ["kaifadu", "renwuzhuang", "chengku"], "证据级别": "本作设定", "source_id": "strategy:strategyInvest", "confidence": "高" },
    { "id": "renkou", "名称": "人口", "分类": "经济", "简述": "每 30 日自然增长 4%；征兵每兵消耗 1 人口。人口 → 兵役 → 征兵上限是一条应可见的回路。", "数值来源": ["city-econ.cityEconTick", "state.cityEcon[id].pop"], "关联词条": ["bingyi", "zhengding"], "证据级别": "本作设定（人口口径出自三国志9，三国志11 已取消人口）", "source_id": "econ:cityEconTick", "confidence": "中" },
    { "id": "bingyi", "名称": "兵役", "分类": "经济", "简述": "可征之兵来自人口。当前版本尚未做成独立可见上限，属待补回路。", "数值来源": ["design:6.7（本作待实装）"], "关联词条": ["renkou", "zhengding"], "证据级别": "设计规格（借鉴三国志9）", "source_id": "design:6.7", "confidence": "中" },
    { "id": "zhengding", "名称": "征兵", "分类": "部队", "简述": "消耗金、粮与人口，按工期完成。征兵与农时冲突应可见。", "数值来源": ["handlers.js army.conscript", "city-econ.conscriptFactor"], "关联词条": ["renkou", "bingyi", "jijie"], "证据级别": "本作设定", "source_id": "handler:army.conscript", "confidence": "高" },
    { "id": "minxin", "名称": "民心", "分类": "内政", "简述": "逐城数值。灾害、欠饷、过境军队会拉低；民心低影响产量与治安。", "数值来源": ["state.cityEcon[id].morale"], "关联词条": ["zhian", "zaihai", "chanliang"], "证据级别": "本作设定", "source_id": "econ:cityEcon", "confidence": "高" },
    { "id": "zhian", "名称": "治安", "分类": "内政", "简述": "治安 100 时灾害概率 ×0.7，治安 0 时 ×1.0。是灾害与兵变的前置条件。", "数值来源": ["city-econ.disasterTick:orderK", "state.cityEcon[id].order"], "关联词条": ["minxin", "zaihai"], "证据级别": "本作设定", "source_id": "econ:disasterTick", "confidence": "高" },
    { "id": "zaihai", "名称": "灾害", "分类": "事件", "简述": "每旬按「灾害风险 × 政务官 × 治安」掷骰，分蝗灾／瘟疫／丰收三档。风险值按东汉灾害地理逐城配置（兖豫最高、益州最低）。确定性种子驱动，可提前预报。", "数值来源": ["conf/campaign/strategy/map.json:attrs.灾害风险", "city-econ.disasterTick", "strategy-rng.rngFor"], "关联词条": ["zhian", "minxin", "yubao", "quedingxing"], "证据级别": "史料地理 + 本作设定", "source_id": "econ:disasterTick", "confidence": "中" },
